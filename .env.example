# Copy to .env and fill in. Never commit .env.

TENANT_ID=6afa0e00-fa14-40b7-8a2e-22a7f8c357d5
CLIENT_ID=dcb36f1d-c6f4-4f90-adde-1fd24c6ba02c

# Auth: certificate (preferred) OR client secret. If both are set, the certificate is used.
# CERT_PATH may be a PEM (private key + cert, needs CERT_THUMBPRINT) or a .pfx/.p12.
CERT_PATH=
CERT_THUMBPRINT=
CERT_PASSWORD=
CLIENT_SECRET=

SITE_ID=cgiar.sharepoint.com,b52f51a1-da6f-44cf-ae92-19bd799c4a27,e6764bfc-ee60-4c44-b932-335f755f9773
DRIVE_ID=b!oVEvtW_az0Sukhm9eZxKJ_xLduZg7kRMuTIzX3Vfl3P5xmZl_roKT6yvRd9D8CX6

# Power Automate "Post to a channel when a webhook request is received" URL for Data Drop.
TEAMS_WEBHOOK_URL=

# Upload key for AWARE Sri Lanka's bulletin upload (same value as MET_UPLOAD_TOKEN in the Vercel project).
MET_UPLOAD_TOKEN=

# Files larger than this are classified by name/email only (no download).
MAX_DOWNLOAD_MB=2048
